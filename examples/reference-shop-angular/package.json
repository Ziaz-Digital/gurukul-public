{
  "name": "gurukul-reference-shop-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Gurukul Capstone reference shop (Angular): the finished grocery shop, built in the starter template, packed as one <gk-project> bundle.",
  "gurukul": {
    "templateVersion": "1.0.0",
    "projectKind": "grocery-shop",
    "framework": "angular",
    "capabilities": [
      "customer-accounts",
      "ask-unavailable-item",
      "favourites-reorder",
      "cancel-before-packing",
      "discount-codes",
      "delivery-fees-cutoffs",
      "click-and-collect",
      "substitutions",
      "product-images",
      "sales-stock-report",
      "suppliers-purchase-orders",
      "opening-hours"
    ]
  },
  "scripts": {
    "dev": "node scripts/write-dev-config.mjs && ng serve",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "ng build",
    "bundle": "npm run build && node scripts/make-bundle.mjs",
    "preview": "node scripts/preview.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/elements": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.17",
    "@angular/cli": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "@playwright/test": "1.61.1",
    "typescript": "5.9.3"
  }
}
