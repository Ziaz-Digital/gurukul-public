{
  "name": "gurukul-grocery-angular",
  "version": "1.0.0",
  "private": true,
  "description": "Gurukul Capstone starter template (Angular): your grocery shop's front end, packed as one <gk-project> bundle.",
  "gurukul": {
    "templateVersion": "1.0.0",
    "projectKind": "grocery-shop",
    "framework": "angular",
    "capabilities": []
  },
  "scripts": {
    "dev": "node scripts/write-dev-config.mjs && ng serve",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "build": "ng build",
    "bundle": "npm run build && node scripts/make-bundle.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/elements": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.17",
    "@angular/cli": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "typescript": "5.9.3"
  }
}
